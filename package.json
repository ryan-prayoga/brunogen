{
  "name": "brunogen",
  "version": "0.5.1",
  "description": "Scan Laravel, Express.js, and Go API projects, normalize them into OpenAPI, and emit ready-to-try Bruno collections.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": "dist/cli.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "demo:laravel": "npm run build && node scripts/update-laravel-demo.js",
    "demo:express": "npm run build && node scripts/update-express-demo.js",
    "demo:go": "npm run build && node scripts/update-go-demo.js",
    "cli:e2e": "node scripts/check-cli-e2e.js",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.js\" \"*.ts\"",
    "pack:check": "node scripts/check-pack-size.js",
    "readme:check": "node scripts/check-readme-links.js",
    "release:check": "node scripts/check-release-version.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run coverage && npm run build && npm run cli:e2e && npm run pack:check && npm run readme:check && npm run release:check && node dist/cli.js --help"
  },
  "keywords": [
    "bruno",
    "openapi",
    "laravel",
    "express",
    "gin",
    "fiber",
    "echo",
    "cli"
  ],
  "author": "Ryan Prayoga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-prayoga/brunogen.git"
  },
  "bugs": {
    "url": "https://github.com/ryan-prayoga/brunogen/issues"
  },
  "homepage": "https://github.com/ryan-prayoga/brunogen#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@typescript-eslint/parser": "^8.60.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
